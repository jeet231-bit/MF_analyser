# Copy to .env to override defaults in development. All keys are prefixed MFA_.
# In production the installer writes C:\MFAnalyser\config.env instead (or MFA_CONFIG_FILE).
# MFA_ENVIRONMENT=development          # development | test | production
# MFA_DATA_DIR=C:\MFAnalyser\data       # never inside OneDrive: the app refuses to start
# MFA_BACKUP_DIR=C:\MFAnalyser\backups  # the local 30-day ring
# MFA_BACKUP_MIRROR=\\server\share\mfa  # off-machine copy, last 4 weekly kept (OneDrive is fine here)
# MFA_LOG_DIR=C:\MFAnalyser\data\logs
# MFA_STATIC_DIR=..\frontend\dist       # the built UI served from the same process
# MFA_HOST=0.0.0.0
# MFA_PORT=8000
# MFA_DATABASE_URL=postgresql+psycopg://user:pass@localhost/mfa
# MFA_MAX_UPLOAD_MB=50
# MFA_AUTH_PASSWORD_HASH=               # set with: uv run python -m app.tools.set_password
# MFA_AUTH_SECRET=                      # generated by the same tool; signs the session cookie
# MFA_SESSION_HOURS=12
