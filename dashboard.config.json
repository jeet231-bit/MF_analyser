    "insights": [
      {
        "key": "best_long_term",
        "section": "winning",
        "eyebrow": "Long term",
        "title": "Best over the long term",
        "where": [
          {
            "measure": "rank_lt",
            "op": "eq",
            "value": 1
          }
        ],
        "sort": {
          "measure": "ret_5y",
          "dir": "desc"
        },
        "limit": 5,
        "show": [
          "measure:ret_5y"
        ],
        "sentence": "{count} funds lead their category on {measure.label}. {top.label} tops the list at {top.value} over five years.",
        "drill": {
          "sort": "rank_lt",
          "dir": "asc"
        }
      },
      {
        "key": "held_q1",
        "section": "winning",
        "eyebrow": "Consistency",
        "title": "Held Q1 every version",
        "mode": "acrossVersions",
        "across": {
          "where": [
            {
              "measure": "quartile",
              "op": "eq",
              "value": 1
            }
          ]
        },
        "limit": 5,
        "sentence": "{count} of {total} current Q1 funds have been Q1 in all {versions} stored versions. Consistency is the signal a single month cannot show."
      },
      {
        "key": "risk_adjusted",
        "section": "winning",
        "eyebrow": "Risk adjusted",
        "title": "Best return per unit of risk",
        "where": [
          {
            "measure": "rank_rar",
            "op": "top"
          },
          {
            "measure": "rank_stddev",
            "op": "top"
          }
        ],
        "sort": {
          "measure": "rank_rar",
          "dir": "asc"
        },
        "limit": 5,
        "show": [
          "measure:rank_rar"
        ],
        "sentence": "{count} funds sit in the top quarter of {measure.label} with a standard-deviation rank in the top quarter too, so the return did not come from volatility alone.",
        "drill": {
          "sort": "rank_rar",
          "dir": "asc"
        }
      },
      {
        "key": "all_weather",
        "section": "behaviour",
        "eyebrow": "All weather",
        "title": "Q1 in bull and bear",
        "where": [
          {
            "measure": "qrtl_bull",
            "op": "eq",
            "value": 1
          },
          {
            "measure": "qrtl_bear",
            "op": "eq",
            "value": 1
          }
        ],
        "sort": {
          "measure": "rank",
          "dir": "asc"
        },
        "limit": 5,
        "show": [
          "quartile_pair"
        ],
        "sentence": "{count} funds sit in the top quartile on both phases. They captured the upside and held the downside."
      },
      {
        "key": "downside",
        "section": "behaviour",
        "eyebrow": "Downside protection",
        "title": "Held up best when markets fell",
        "where": [
          {
            "measure": "bear",
            "op": "notnull"
          }
        ],
        "sort": {
          "measure": "bear",
          "dir": "desc"
        },
        "limit": 5,
        "show": [
          "measure:bear"
        ],
        "sentence": "Top {measure.label} across the bear phases. {top.label} leads at {top.value}; useful for conservative allocations even where the bull rank is mid-table.",
        "drill": {
          "sort": "bear",
          "dir": "desc"
        }
      },
      {
        "key": "high_vol",
        "section": "behaviour",
        "eyebrow": "Caution",
        "title": "High return, high volatility",
        "where": [
          {
            "measure": "roll3y",
            "op": "top"
          },
          {
            "measure": "rank_stddev",
            "op": "bottom"
          }
        ],
        "sort": {
          "measure": "roll3y",
          "dir": "desc"
        },
        "limit": 5,
        "show": [
          "measure:roll3y"
        ],
        "sentence": "{count} funds rank top-quartile on {measure.label} but bottom-quartile on standard deviation. The return came with the ride."
      },
      {
        "key": "amc_league",
        "section": "houses",
        "eyebrow": "AMC league table",
        "title": "Q1 funds by house",
        "mode": "groupBy",
        "groupBy": {
          "dimension": "amc",
          "aggregate": "count_where",
          "where": [
            {
              "measure": "quartile",
              "op": "eq",
              "value": 1
            }
          ],
          "minMembers": 2
        },
        "limit": 6,
        "sentence": "{group.label} has the most top-quartile funds ({group.count} of {group.total} rated); {hit.label} has the highest hit rate, with {hit.count} of its {hit.total} rated funds in Q1."
      },
      {
        "key": "manager_league",
        "section": "houses",
        "eyebrow": "Fund managers",
        "title": "Most Q1 funds managed",
        "mode": "groupBy",
        "groupBy": {
          "dimension": "manager",
          "aggregate": "count_where",
          "where": [
            {
              "measure": "quartile",
              "op": "eq",
              "value": 1
            }
          ],
          "minMembers": 2
        },
        "limit": 6,
        "sentence": "From the manager column on the master. {group.label} runs {group.count} top-quartile funds out of {group.total} rated."
      },
      {
        "key": "dispersion",
        "section": "houses",
        "eyebrow": "Selection matters",
        "title": "Widest dispersion",
        "mode": "groupBy",
        "groupBy": {
          "dimension": "category",
          "aggregate": "dispersion",
          "measure": "roll3y",
          "minMembers": 4
        },
        "limit": 6,
        "sentence": "Categories where the gap between the best and worst fund on {measure.label} is largest are where picking well pays most; {group.label} spans {group.value}.",
        "sort": {
          "measure": "roll3y",
          "dir": "desc"
        }
      },
      {
        "key": "best_value",
        "section": "cost",
        "eyebrow": "Best value",
        "title": "Q1 performance at Q1 cost",
        "where": [
          {
            "measure": "quartile",
            "op": "eq",
            "value": 1
          },
          {
            "measure": "qrtl_expense",
            "op": "eq",
            "value": 1
          }
        ],
        "sort": {
          "measure": "expense",
          "dir": "asc"
        },
        "limit": 5,
        "show": [
          "measure:expense"
        ],
        "sentence": "{count} funds are top quartile on composite rank and top quartile on expense: performance that is not being paid for twice."
      },
      {
        "key": "expensive_laggards",
        "section": "cost",
        "eyebrow": "Review",
        "title": "Expensive and lagging",
        "where": [
          {
            "measure": "quartile",
            "op": "eq",
            "value": 4
          },
          {
            "measure": "qrtl_expense",
            "op": "eq",
            "value": 4
          }
        ],
        "sort": {
          "measure": "expense",
          "dir": "desc"
        },
        "limit": 5,
        "show": [
          "measure:expense"
        ],
        "sentence": "{count} funds sit in Q4 on both composite rank and expense. These are the exit conversations."
      },
      {
        "key": "corpus_at_risk",
        "section": "cost",
        "eyebrow": "Investor impact",
        "title": "Large funds in the bottom half",
        "mode": "aggregate",
        "aggregate": {
          "measure": "corpus",
          "fn": "sum"
        },
        "where": [
          {
            "measure": "quartile",
            "op": "gte",
            "value": 3
          }
        ],
        "limit": 5,
        "sentence": "Weighted by corpus: {sum} sits in {count} funds ranked Q3 or Q4, and a small number of large funds carries most of it."
      }
    ],
    "narratives": {
      "dashboard": "{moved} funds changed rank since {previous}: {up} up, {down} down. {repairs} of those moves are data repairs, not market movement. {held_q1} funds have held Q1 across all {versions} stored versions.",
      "movement": "{moved} funds changed composite rank between {previous} and {current}: {up} up and {down} down; {into_q1} entered Q1 and {out_of_q1} left it. {repairs} of the moves are data repairs rather than market movement.",
      "categories": "{categories} categories, {unranked} left unranked by the workbook rule. {widest.label} has the widest spread in {measure.label} ({widest.value}); {best.label} has the highest average at {best.value}.",
      "fund": "{label} ranks {rank} of {category_count} rated funds in {category}, quartile {quartile}, {delta} since {previous}."
    },
