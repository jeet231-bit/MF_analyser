    "phases": {
      "sheet": "Bull-Bear Returns",
      "keyColumn": "P",
      "headerRow": 9,
      "unit": "%",
      "groups": [
        {
          "key": "bull",
          "label": "Bull",
          "columns": [
            "W",
            "X",
            "Y",
            "Z",
            "AA"
          ]
        },
        {
          "key": "bear",
          "label": "Bear",
          "columns": [
            "AK",
            "AL",
            "AM",
            "AN",
            "AO"
          ]
        }
      ]
    },
    "periods": {
      "sheet": "Summary-Performance",
      "keyColumn": "C",
      "headerRow": 9,
      "columns": [
        "N",
        "O",
        "P",
        "Q",
        "R",
        "S"
      ],
      "unit": "%"
    },
    "categoryStats": {
      "sheet": "Averages",
      "keyColumn": "C",
      "rows": [
        8,
        49
      ],
      "headerRow": 7,
      "columns": [
        "F",
        "G",
        "H",
        "I",
        "J",
        "K",
        "L"
      ],
      "unit": "%"
    },
    "quartileRule": {
      "unrankedBelow": 4,
      "unrankedValue": "--"
    },
    "insights": [
      {
        "key": "best_long_term",
        "section": "winning",
        "eyebrow": "Long term",
        "title": "Best on long-term rank",
        "where": [
          {
            "measure": "rank_lt",
            "op": "eq",
            "value": 1
          }
        ],
        "sort": {
          "measure": "score",
          "dir": "desc"
        },
        "limit": 5,
        "show": [
          "measure:score"
        ],
        "sentence": {
          "default": "Across the {groups} categories with {min_group} or more rated funds, {top.label} leads its category ({top.group}) on long-term rank."
        },
        "drill": {
          "sort": "rank_lt",
          "dir": "asc"
        },
        "minGroupCount": 10
      },
      {
        "key": "held_q1",
        "section": "winning",
        "eyebrow": "Consistency",
        "title": "Held Q1 every version",
        "mode": "acrossVersions",
        "across": {
          "where": [
            {
              "measure": "quartile",
              "op": "eq",
              "value": 1
            }
          ]
        },
        "limit": 5,
        "sentence": {
          "default": "{count} of {total} current Q1 funds {count?has|have} been Q1 in every one of the {versions} genuine monthly uploads. Consistency is the signal a single month cannot show.",
          "zero": "None of the {total} current Q1 funds has held Q1 across all {versions} genuine monthly uploads."
        }
      },
      {
        "key": "risk_adjusted",
        "section": "winning",
        "eyebrow": "Risk adjusted",
        "title": "Best return per unit of risk",
        "where": [
          {
            "measure": "rank_rar",
            "op": "top"
          },
          {
            "measure": "rank_stddev",
            "op": "top",
            "fraction": 0.5
          }
        ],
        "sort": {
          "measure": "rank_rar",
          "dir": "asc"
        },
        "limit": 5,
        "show": [
          "measure:rank_rar"
        ],
        "sentence": {
          "default": "{count|fund is|funds are} in the top quarter of their category on {measure.label} while sitting in the top half on standard deviation: the return did not come from volatility alone.",
          "zero": "No fund combines a top-quarter {measure.label} with a top-half standard-deviation rank this month."
        },
        "drill": {
          "sort": "rank_rar",
          "dir": "asc"
        }
      },
      {
        "key": "all_weather",
        "section": "behaviour",
        "eyebrow": "All weather",
        "title": "Q1 in bull and bear",
        "where": [
          {
            "measure": "qrtl_bull",
            "op": "eq",
            "value": 1
          },
          {
            "measure": "qrtl_bear",
            "op": "eq",
            "value": 1
          }
        ],
        "sort": {
          "measure": "rank",
          "dir": "asc"
        },
        "limit": 5,
        "show": [
          "quartile_pair"
        ],
        "sentence": {
          "default": "{count|fund sits|funds sit} in the top quartile on both phases. They captured the upside and held the downside.",
          "zero": "No fund is top quartile on both the bull and the bear phases this month."
        }
      },
      {
        "key": "downside",
        "section": "behaviour",
        "eyebrow": "Downside protection",
        "title": "Held up best when markets fell",
        "where": [
          {
            "measure": "bear",
            "op": "notnull"
          }
        ],
        "sort": {
          "measure": "bear",
          "dir": "desc"
        },
        "limit": 5,
        "show": [
          "measure:bear"
        ],
        "sentence": {
          "default": "{top.label} leads the bear-phase composite at {top.value}; useful for conservative allocations even where the bull rank is mid-table."
        },
        "drill": {
          "sort": "bear",
          "dir": "desc"
        }
      },
      {
        "key": "high_vol",
        "section": "behaviour",
        "eyebrow": "Caution",
        "title": "High return, high volatility",
        "where": [
          {
            "measure": "roll3y",
            "op": "top"
          },
          {
            "measure": "rank_stddev",
            "op": "bottom"
          }
        ],
        "sort": {
          "measure": "roll3y",
          "dir": "desc"
        },
        "limit": 5,
        "show": [
          "measure:roll3y"
        ],
        "sentence": {
          "default": "{count|fund ranks|funds rank} top-quartile on {measure.label} but bottom-quartile on standard deviation. The return came with the ride.",
          "zero": "No fund pairs a top-quartile {measure.label} with a bottom-quartile standard deviation this month."
        }
      },
      {
        "key": "amc_league",
        "section": "houses",
        "eyebrow": "AMC league table",
        "title": "Q1 funds by house",
        "mode": "groupBy",
        "groupBy": {
          "dimension": "amc",
          "aggregate": "count_where",
          "where": [
            {
              "measure": "quartile",
              "op": "eq",
              "value": 1
            }
          ]
        },
        "limit": 6,
        "sentence": {
          "default": "{group.label} has the most top-quartile funds ({group.count} of {group.total} rated); {hit.label} has the highest hit rate, with {hit.count} of its {hit.total} rated funds in Q1. Houses with fewer than {min_group} rated funds are not ranked."
        },
        "minGroupCount": 10
      },
      {
        "key": "manager_league",
        "section": "houses",
        "eyebrow": "Management teams",
        "title": "Q1 funds by management team",
        "mode": "groupBy",
        "groupBy": {
          "dimension": "manager",
          "aggregate": "count_where",
          "where": [
            {
              "measure": "quartile",
              "op": "eq",
              "value": 1
            }
          ]
        },
        "limit": 6,
        "sentence": {
          "default": "The master lists teams, not individuals: {group.label} manages {group.count|top-quartile fund|top-quartile funds} out of {group.total} rated. Teams with fewer than {min_group} rated funds are not ranked."
        },
        "minGroupCount": 10
      },
      {
        "key": "dispersion",
        "section": "houses",
        "eyebrow": "Selection matters",
        "title": "Widest dispersion",
        "mode": "groupBy",
        "groupBy": {
          "dimension": "category",
          "aggregate": "dispersion",
          "measure": "roll3y"
        },
        "limit": 6,
        "sentence": {
          "default": "Among the {groups} categories with {min_group} or more rated funds, the gap between the best and worst fund on {measure.label} is widest in {group.label} ({group.value}); that is where picking well pays most."
        },
        "sort": {
          "measure": "roll3y",
          "dir": "desc"
        },
        "minGroupCount": 10
      },
      {
        "key": "best_value",
        "section": "cost",
        "eyebrow": "Best value",
        "title": "Q1 performance at Q1 cost",
        "where": [
          {
            "measure": "quartile",
            "op": "eq",
            "value": 1
          },
          {
            "measure": "qrtl_expense",
            "op": "eq",
            "value": 1
          }
        ],
        "sort": {
          "measure": "expense",
          "dir": "asc"
        },
        "limit": 5,
        "show": [
          "measure:expense"
        ],
        "sentence": {
          "default": "{count|fund is|funds are} top quartile on composite rank and top quartile on expense: performance that is not being paid for twice.",
          "zero": "No fund is top quartile on both composite rank and expense this month."
        }
      },
      {
        "key": "expensive_laggards",
        "section": "cost",
        "eyebrow": "Review",
        "title": "Expensive and lagging",
        "where": [
          {
            "measure": "quartile",
            "op": "eq",
            "value": 4
          },
          {
            "measure": "qrtl_expense",
            "op": "eq",
            "value": 4
          }
        ],
        "sort": {
          "measure": "expense",
          "dir": "desc"
        },
        "limit": 5,
        "show": [
          "measure:expense"
        ],
        "sentence": {
          "default": "{count|fund sits|funds sit} in Q4 on both composite rank and expense. These are the exit conversations.",
          "zero": "No fund sits in Q4 on both composite rank and expense this month."
        }
      },
      {
        "key": "corpus_at_risk",
        "section": "cost",
        "eyebrow": "Investor impact",
        "title": "Large funds in the bottom half",
        "mode": "aggregate",
        "aggregate": {
          "measure": "corpus",
          "fn": "sum"
        },
        "where": [
          {
            "measure": "quartile",
            "op": "gte",
            "value": 3
          }
        ],
        "limit": 5,
        "sentence": {
          "default": "{sum} sits in {count|fund|funds} ranked Q3 or Q4, and a small number of large funds carries most of it.",
          "zero": "No rated fund sits in Q3 or Q4 this month."
        }
      }
    ],
    "narratives": {
      "universe": [
        {
          "default": "{rated} of {total} funds are rated."
        },
        {
          "default": "{unranked} of {categories} categories {unranked?has|have} fewer than {unranked_below} ranked funds and {unranked?is|are} left unranked by the workbook's own rule ({unrated_small|fund|funds}).",
          "zero": "Every category has at least {unranked_below} ranked funds, so none is left unranked by the workbook rule."
        },
        {
          "default": "{unrated_other|fund is|funds are} unrated because the master shows \"--\" for part of the composite."
        },
        {
          "default": "{outside|fund sits|funds sit} outside the universe flag."
        }
      ],
      "dashboard": [
        {
          "default": "{moved|fund|funds} changed rank since {previous}: {up} up, {down} down.",
          "zero": "No fund changed rank since {previous}."
        },
        {
          "default": "{repairs} of those moves {repairs?is a data repair|are data repairs}, not market movement.",
          "zero": "None of those moves is a data repair.",
          "requires": [
            "moved"
          ]
        },
        {
          "default": "{held_q1|fund has|funds have} held Q1 across all {versions} genuine monthly uploads.",
          "zero": "No fund has held Q1 across all {versions} genuine monthly uploads."
        }
      ],
      "movement": [
        {
          "default": "{moved|fund|funds} changed composite rank between {previous} and {current}: {up} up and {down} down.",
          "zero": "No fund changed composite rank between {previous} and {current}."
        },
        {
          "default": "{into_q1} entered Q1 and {out_of_q1} left it.",
          "zero": "No fund crossed the Q1 line.",
          "trigger": [
            "into_q1",
            "out_of_q1"
          ],
          "requires": [
            "moved"
          ]
        },
        {
          "default": "{repairs} of the moves {repairs?is a data repair|are data repairs} rather than market movement.",
